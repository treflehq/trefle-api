<%# Sections manage their own container/washes edge to edge (maquette),
    so the layout must not wrap this page in a padded Bulma .section.
    Kept outside the cache block: content_for is a side effect that a
    cached fragment would not replay. %>
<% provide :full_bleed, '1' %>
<%# expires_in: the fragment embeds the dataset counts, which must not stay
    frozen at their value on deploy day. SiteCounts caches them for a day. %>
<div class="home-page">
  <% cache [:home, :index, TrefleAdmin::Application::VERSION, current_user.nil?, current_user&.admin], expires_in: 1.day do %>
    <%= render 'home/hero' %>
    <%= render 'home/start_here' %>
    <%= render 'home/explore' %>
    <%= render 'home/data', stats: @home_stats %>
  <% end %>

  <%# The correction figures move with every decision: their own fragment,
      keyed on the latest filed or decided correction, instead of the
      day-long page cache that kept showing the morning's counts. %>
  <% cache [:home, :changes, TrefleAdmin::Application::VERSION, @home_stats.corrections_stamp], expires_in: 1.hour do %>
    <%= render 'home/changes', stats: @home_stats %>
  <% end %>

  <% cache [:home, :index_bottom, TrefleAdmin::Application::VERSION, current_user.nil?, current_user&.admin], expires_in: 1.day do %>
    <%= render 'home/developers' %>
    <%= render 'home/partners' %>
    <%= render 'home/volunteer' %>
    <%= render 'home/support' %>
  <% end %>
</div>

<script>
  var temp_token = "<%= @jwt.token %>";
  var _enableManagement = <%= current_user&.admin ? 'true' : 'false' %>;
</script>

<%= javascript_include_tag 'codesandbox' %>
