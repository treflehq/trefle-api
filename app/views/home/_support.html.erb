<section id="support" class="home-section">
  <div class="home-section__inner home-support">
    <%= render 'home/section_heading', icon: 'hand-holding-heart', title: 'We need your support' %>

    <div class="home-support__body">
      <p>
        Trefle is an Open Source API and the code &amp; platform are provided totally free of charge. Donations
        help keep the servers running and allow us to dedicate more time to ongoing development.
      </p>
      <div class="home-support__ctas">
        <a href="<%= donate_path %>" class="button is-primary">Read more on how you can help us</a>
        <a href="https://github.com/sponsors/treflehq">Sponsor on GitHub</a>
      </div>
    </div>
  </div>
</section>
